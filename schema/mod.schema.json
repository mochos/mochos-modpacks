{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mochos/mochos-modpacks/main/schema/mod.schema.json",
  "title": "Mod de Mochos Studio",
  "type": "object",
  "required": ["id", "name", "summary", "builds"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Id del mod (modId). Debe coincidir con el nombre de la carpeta y con el inicio de cada jar." },
    "name": { "type": "string" },
    "summary": { "type": "string", "description": "Frase corta para el aviso del launcher." },
    "icon": { "type": "string" },
    "hidden": { "type": "boolean", "description": "El launcher no lo ofrece." },
    "builds": {
      "type": "array",
      "minItems": 1,
      "description": "Una entrada por jar compilado. El launcher ofrece el de versión más alta compatible con el modpack.",
      "items": {
        "type": "object",
        "required": ["file", "version", "minecraft", "loader"],
        "properties": {
          "file": { "type": "string", "description": "Ruta del jar dentro de la carpeta: builds/<id>-<versión>-MC<Minecraft>-<loader><versión mínima>.jar" },
          "version": { "type": "string", "description": "Versión del mod." },
          "minecraft": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Versiones de Minecraft compatibles." },
          "loader": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["fabric", "quilt", "forge", "neoforge"] },
              "minVersion": { "type": "string", "description": "Versión mínima del loader (sin ella, cualquiera)." }
            }
          }
        }
      }
    }
  }
}
